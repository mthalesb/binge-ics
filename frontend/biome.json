{
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.next",
			"!**/next-env.d.ts",
			"!public"
		]
	},
	"formatter": {
		"indentStyle": "tab"
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"jsxQuoteStyle": "single"
		}
	}
}
